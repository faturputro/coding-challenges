{
  "name": "coding-challenges",
  "version": "1.0.0",
  "description": "Real-time quiz starter",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:worker\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch src/server --ext ts --exec 'node -r @swc-node/register src/server/index.ts'",
    "dev:worker": "nodemon --watch src/server --ext ts --exec 'node -r @swc-node/register src/server/worker.ts'",
    "dev:client": "vite --config config/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite --config config/vite.config.ts build",
    "build:server": "swc src/server -d dist",
    "start": "NODE_ENV=production node -r ./dist/server/instrumentation.js dist/server/index.js",
    "start:worker": "NODE_ENV=production OTEL_SERVICE_NAME=\"${OTEL_SERVICE_NAME:-elsa}-worker\" node -r ./dist/server/instrumentation.js dist/server/worker.js",
    "test": "npm run build && node --test tests/*.cjs",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openobserve/browser-logs": "^0.4.3",
    "@openobserve/browser-rum": "^0.4.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation-host-metrics": "^0.5.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@overnightjs/core": "^1.7.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.3.1",
    "fast-redact": "^3.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jose": "^5.2.0",
    "lucide-vue-next": "^0.323.0",
    "pg": "^8.12.0",
    "radix-vue": "^1.8.3",
    "rate-limit-redis": "^4.2.0",
    "reflect-metadata": "^0.2.1",
    "sequelize": "^6.35.2",
    "sequelize-cli": "^6.6.2",
    "sequelize-typescript": "^2.1.6",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^2.6.0",
    "uuid": "11.1.0",
    "validatorjs": "^3.22.1",
    "vue": "^3.4.18",
    "vue-router": "^4.6.4",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.6.8",
    "@swc/cli": "^0.1.63",
    "@swc/core": "^1.3.102",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/fast-redact": "^3.0.4",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.8",
    "@types/validatorjs": "^3.15.5",
    "@vitejs/plugin-vue": "^5.0.3",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.3.3",
    "vite": "^5.0.11",
    "vue-tsc": "^1.8.27"
  }
}
