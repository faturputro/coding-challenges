PORT=9000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quiz
DB_USER=postgres
DB_PASSWORD=
DB_TEST_NAME=quiz_test

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
LOG_LEVEL=info

SUBMISSION_WORKER_CONCURRENCY=5

APP_PKCS8_KEY=
SOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9000

# Observability (OpenObserve via OpenTelemetry). Disabled when NODE_ENV=development.
OTEL_SERVICE_NAME=elsa
OPENOBSERVE_URL=https://your-openobserve-host
OPENOBSERVE_ORG=default
OPENOBSERVE_EMAIL=root@example.com
OPENOBSERVE_PASSWORD=
OPENOBSERVE_DEBUG=false

# Browser RUM + logs (baked into the client at build time)
VITE_OPENOBSERVE_CLIENT_TOKEN=
VITE_OPENOBSERVE_SITE=your-openobserve-host
VITE_OPENOBSERVE_ORG=default
VITE_OPENOBSERVE_APP_ID=quiz-web
